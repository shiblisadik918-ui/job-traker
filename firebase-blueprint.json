{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile document stored under users/{userId}",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The user's unique ID from Firebase Auth" },
        "email": { "type": "string", "description": "The user's email address" },
        "displayName": { "type": "string", "description": "The user's full display name" },
        "photoURL": { "type": "string", "description": "The user's profile photo URL or base64 image" },
        "targetRole": { "type": "string", "description": "Target job position or career title" },
        "phone": { "type": "string", "description": "Contact telephone number" },
        "address": { "type": "string", "description": "Residential or mailing address" },
        "careerObjective": { "type": "string", "description": "Career objective statement" },
        "careerSummary": { "type": "string", "description": "Professional career summary" },
        "workExperience": { "type": "string", "description": "Work history or fresher qualification details" },
        "specialQualifications": { "type": "string", "description": "Key skills and special qualifications" },
        "languageProficiency": { "type": "string", "description": "Language skills and proficiencies" },
        "personalDetails": { "type": "string", "description": "Personal details (Father's name, DOB, nationality, etc.)" },
        "portfolioUrl": { "type": "string", "description": "Portfolio or personal website URL" },
        "linkedinUrl": { "type": "string", "description": "LinkedIn profile URL" },
        "jobSearchStatus": { "type": "string", "description": "Current job search status" },
        "workMode": { "type": "string", "description": "Preferred work modality (Remote, Hybrid, On-site)" },
        "targetSalary": { "type": "string", "description": "Target salary range" },
        "preferredLocation": { "type": "string", "description": "Preferred location" },
        "bio": { "type": "string", "description": "Short bio or elevator pitch" },
        "isVerified": { "type": "boolean", "description": "Whether the user profile is 100% completed and verified" },
        "profileCompleteness": { "type": "number", "description": "Profile completion percentage (0-100)" },
        "createdAt": { "type": "string", "description": "Server creation timestamp" },
        "updatedAt": { "type": "string", "description": "Server last update timestamp" }
      },
      "required": ["uid", "email"]
    },
    "Application": {
      "title": "Application",
      "description": "Job application document stored under users/{userId}/applications/{applicationId}",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Document ID" },
        "userId": { "type": "string", "description": "Owner user ID" },
        "job_type": {
          "type": "string",
          "enum": ["Government", "Private"],
          "description": "Job classification: Bangladesh Government or Private/MNC"
        },
        "companyName": { "type": "string", "description": "Company or Ministry/Department name", "minLength": 1, "maxLength": 200 },
        "companyLogo": { "type": "string", "description": "Company logo URL or monogram string" },
        "jobTitle": { "type": "string", "description": "Job title or position", "minLength": 1, "maxLength": 200 },
        "location": { "type": "string", "description": "Office or remote location" },
        "jobType": {
          "type": "string",
          "enum": ["Full-time", "Part-time", "Internship", "Contract", "Remote"]
        },
        "applicationDate": { "type": "string", "description": "Date applied (YYYY-MM-DD or ISO string)" },
        "deadline": { "type": "string", "description": "Application or next step deadline" },
        "applicationSource": {
          "type": "string",
          "description": "Job source (LinkedIn, Bdjobs, Chakri.com, Teletalk, etc.)"
        },
        "salary": { "type": "string", "description": "Salary or compensation range" },
        "jobUrl": { "type": "string", "description": "Listing or circular URL" },
        "status": {
          "type": "string",
          "enum": ["Saved", "Applied", "Shortlisted", "Interview", "Offer", "Rejected", "Withdrawn"]
        },
        "priority": {
          "type": "string",
          "enum": ["Low", "Medium", "High"]
        },
        "notes": { "type": "string", "description": "Personal application notes" },

        "ministryDepartment": { "type": "string", "description": "Government Ministry or Department name" },
        "jobGrade": { "type": "string", "description": "Government pay scale grade (e.g., 9th Grade, 11th Grade)" },
        "circularId": { "type": "string", "description": "Government circular reference ID" },
        "applicationFee": { "type": "string", "description": "Application fee amount" },
        "paymentStatus": {
          "type": "string",
          "enum": ["Pending", "Paid via Teletalk SMS", "Paid via Online/bKash/Nagad", "Exempted"],
          "description": "Government application fee payment status"
        },
        "admitCardStatus": {
          "type": "string",
          "enum": ["Not Published", "Download Available", "Downloaded", "Center Assigned"],
          "description": "Government admit card publication status"
        },
        "userRollNumber": { "type": "string", "description": "Applicant roll number / registration ID" },
        "govtExamStages": {
          "type": "array",
          "description": "Sequential government exam stages: Prelims -> Written -> Viva -> Final Result"
        },

        "recruiterName": { "type": "string", "description": "HR or Recruiter contact name" },
        "recruiterEmail": { "type": "string", "description": "HR or Recruiter email" },
        "recruiterPhone": { "type": "string", "description": "HR or Recruiter phone" },
        "recruiterRole": { "type": "string", "description": "HR or Recruiter title" },
        "privateInterviewRounds": {
          "type": "array",
          "description": "Private interview rounds: Phone Screen -> Tech -> HR -> Final Offer"
        },

        "timeline": {
          "type": "array",
          "description": "History of status updates and notes"
        },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last update timestamp" }
      },
      "required": ["companyName", "jobTitle", "status", "userId"]
    },
    "Reminder": {
      "title": "Reminder",
      "description": "Reminder task stored under users/{userId}/reminders/{reminderId}",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Document ID" },
        "userId": { "type": "string", "description": "Owner user ID" },
        "applicationId": { "type": "string", "description": "Optional associated job application ID" },
        "title": { "type": "string", "description": "Reminder title or action item", "minLength": 1, "maxLength": 200 },
        "dueDate": { "type": "string", "description": "Reminder due date/time" },
        "completed": { "type": "boolean", "description": "Completion status flag" },
        "notes": { "type": "string", "description": "Additional reminder notes" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last update timestamp" }
      },
      "required": ["title", "userId", "completed"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private profile document for each registered user"
    },
    "/users/{userId}/applications/{applicationId}": {
      "schema": "Application",
      "description": "User's job applications tracking subcollection"
    },
    "/users/{userId}/reminders/{reminderId}": {
      "schema": "Reminder",
      "description": "User's task and interview reminders subcollection"
    }
  }
}
